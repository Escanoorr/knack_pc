// SPDX-License-Identifier: GPL-2.0-or-later
// knack: helpers around DLSS for Knack (docs/knack-dlss.md).
//
// MOTION_PASS: the game's own velocity target (R16G16F, written by every G-buffer pixel shader as
//   current - previous position in normalized device coordinates: x/w and y/w of the clip position
//   that gl_Position also uses, minus the one made with the previous frame's matrices and object
//   transforms; animated objects and the camera are both in it) becomes DLSS motion vectors:
//   render pixels, PREVIOUS minus CURRENT ("added to the pixel's position it gives where it was in
//   the last frame"), x to the right, y down. So `scale` is (-width / 2, +height / 2): the minus
//   turns current - previous into previous - current, and NDC y points up while the image's y
//   points down. The sky (clear depth) has no velocity of its own.
//
// MERGE_PASS: writes DLSS's colour back into the game's HDR scene colour, keeping the game's
//   alpha (its post-processing reads data from it). Debug modes show the motion vectors given to
//   DLSS instead of the image: 1 magnitude (red |x|, green |y|, 8 render pixels = full); 2 signed
//   (grey = none, redder = to the right, cyan = left, greener = down, magenta = up; 16 px = full).
//   3 split screen: DLSS on the left half, the game's own frame on the right (a bright line between);
//   4 difference: how much DLSS changed the frame, |DLSS - game| (brighter = more).
#version 450
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8) in;

#ifdef MOTION_PASS

layout(binding = 0) uniform texture2D velocity_tex;
layout(binding = 1, rg16f) uniform writeonly image2D motion_img;
layout(binding = 2) uniform texture2D depth_tex;

layout(push_constant) uniform Constants {
    vec2 scale;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(motion_img)))) {
        return;
    }
    vec2 v = texelFetch(velocity_tex, pixel, 0).rg;
    // A target that was never cleared can hold anything: keep NaN and infinity out of DLSS.
    if (any(isnan(v)) || any(isinf(v)) || texelFetch(depth_tex, pixel, 0).r >= 1.0) {
        v = vec2(0.0);
    }
    imageStore(motion_img, pixel, vec4(v * scale, 0.0, 0.0));
}

#endif

#ifdef MERGE_PASS

#ifndef SCENE_FORMAT
#define SCENE_FORMAT rgba16f  // the HDR scene colour; rgba8 for the tone-mapped (LDR) image
#endif

layout(binding = 0) uniform texture2D dlss_tex;
layout(binding = 1, SCENE_FORMAT) uniform image2D scene;
layout(binding = 2) uniform texture2D motion_tex;

layout(push_constant) uniform Params {
    uint mode;
};

void main() {
    const ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(scene)))) {
        return;
    }
    const vec4 original = imageLoad(scene, pixel);
    vec3 color = texelFetch(dlss_tex, pixel, 0).rgb;
    if (any(isnan(color)) || any(isinf(color))) {
        color = original.rgb;
    }
    color = max(color, vec3(0.0));
    if (mode == 1u) {
        const vec2 mv = texelFetch(motion_tex, pixel, 0).rg;
        const float luma = dot(min(color, vec3(1.0)), vec3(0.3, 0.6, 0.1));
        color = vec3(luma * 0.3) + vec3(clamp(abs(mv) / 8.0, 0.0, 1.0), 0.0);
    } else if (mode == 2u) {
        const vec2 mv = texelFetch(motion_tex, pixel, 0).rg;
        color = vec3(clamp(vec2(0.5) + mv / 16.0, vec2(0.0), vec2(1.0)), 0.5);
    } else if (mode == 3u) {
        const int half_width = imageSize(scene).x / 2;
        if (pixel.x >= half_width) {
            color = original.rgb;
        }
        if (abs(pixel.x - half_width) <= 1) {
            color = vec3(8.0);
        }
    } else if (mode == 4u) {
        color = vec3(length(abs(color - original.rgb)) * 6.0);
    }
    imageStore(scene, pixel, vec4(color, original.a));
}

#endif
